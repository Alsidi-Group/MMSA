<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mmsa.records"
    android:versionCode="8"
    android:versionName="1.4.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <!-- الإذنان الوحيدان: فحص وجود إصدار جديد من التطبيق فقط — لا إرسال أي بيانات -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="منظومة البيانات"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/MMSA"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:debuggable="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ListActivity"
            android:exported="false" />
        <activity
            android:name=".PrintPreviewActivity"
            android:exported="false" />
        <activity
            android:name=".StatsActivity"
            android:exported="false" />
        <activity
            android:name=".ToolsActivity"
            android:exported="false" />
        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <provider
            android:name=".MiniFileProvider"
            android:authorities="com.mmsa.records.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
